// app:caps — the capability standard library (BUILD_SPEC.md §5), canonical
// source. The build worker copies this into each crate's wit/deps/caps/.
// A grant in the design graph becomes one of these imports; anything not
// granted is physically absent from the component.
package app:caps@0.1.0;

interface kv-store {
  // Records travel as field tuples in v0; hosts map them onto their storage
  // (IndexedDB in the browser, Postgres on the server, SQLite on desktop).
  // Filters are (field, op, value): op is "eq" | "neq" | "contains" and value
  // is JSON-encoded, so the host reconstructs the exact Value and evaluates it
  // with the same matcher the interpreter uses.
  insert: func(store: string, fields: list<tuple<string, string>>) -> result<_, string>;
  query: func(store: string, field: string, op: string, value: string) -> result<list<string>, string>;
  update: func(store: string, field: string, op: string, value: string, fields: list<tuple<string, string>>) -> result<_, string>;
  delete: func(store: string, field: string, op: string, value: string) -> result<_, string>;
}

interface toast {
  show: func(message: string);
}

interface clock {
  now-ms: func() -> u64;
}

interface nav {
  go: func(route: string);
}

// A body's own page-state output channel (SetState lowers to this). Unlike
// kv/toast/nav it is a base capability every host supplies, not a grantable
// external effect: writing your page's state is output, not reaching outward.
// `value` is JSON-encoded so the host reconstructs the exact Value.
interface ui-state {
  set: func(path: string, value: string);
}
